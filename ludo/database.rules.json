{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$/)",
        ".write": "$code.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$/)",
        "state": {
          ".validate": "newData.isString() && newData.val().length < 100000"
        },
        "reactions": {
          ".indexOn": ["t"],
          "$id": {
            ".validate": "newData.hasChildren(['u', 'e', 't']) && newData.child('e').isString() && newData.child('e').val().length <= 8"
          }
        },
        "presence": {
          "$uid": { ".validate": "newData.isBoolean()" }
        },
        "$other": { ".validate": false }
      }
    },
    "race": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$/)",
        ".write": "$code.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$/)",
        "state": {
          ".validate": "newData.isString() && newData.val().length < 20000"
        },
        "k": {
          "$id": { ".validate": "newData.isString() && newData.val().length < 200" }
        },
        "ev": {
          "$id": {
            ".validate": "newData.hasChildren(['k', 'c']) && newData.child('k').isString() && newData.child('k').val().length <= 8",
            "$f": { ".validate": "!newData.hasChildren() && (newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length < 64))" }
          }
        },
        "presence": {
          "$uid": { ".validate": "newData.isBoolean()" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
