{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$/)",
        ".write": "$code.matches(/^[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]$/)",
        "state": {
          ".validate": "newData.isString() && newData.val().length < 100000"
        },
        "reactions": {
          ".indexOn": ["t"],
          "$id": {
            ".validate": "newData.hasChildren(['u', 'e', 't']) && newData.child('e').isString() && newData.child('e').val().length <= 8"
          }
        },
        "presence": {
          "$uid": { ".validate": "newData.isBoolean()" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
